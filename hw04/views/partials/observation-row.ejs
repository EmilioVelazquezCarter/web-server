<li id="obs-<%= observation.id %>" data-id="<%= observation.id %>" class="flex flex-wrap items-center gap-3 border-b border-slate-200 py-3 px-2">
  <span class="font-mono text-sm font-semibold text-slate-700"><%= observation.treeId %></span>

  <span class="inline-block rounded-full px-2 py-1 text-xs font-medium
    <% if (observation.phenophase === 'bud break') { %>bg-lime-100 text-lime-800
    <% } else if (observation.phenophase === 'leaf development') { %>bg-green-100 text-green-800
    <% } else if (observation.phenophase === 'flowering') { %>bg-pink-100 text-pink-800
    <% } else if (observation.phenophase === 'leaf color change') { %>bg-amber-100 text-amber-800
    <% } else { %>bg-orange-100 text-orange-800
    <% } %>">
    <%= observation.phenophase %>
  </span>

  <span class="text-sm text-slate-500"><%= observation.date %></span>
  <span class="text-sm text-slate-500"><%= observation.percent != null ? observation.percent + '%' : '—' %></span>

  <span class="ml-auto">
    <% if (observation.confirmed) { %>
      <span class="inline-block rounded-full bg-emerald-100 px-2 py-1 text-xs font-semibold text-emerald-800">Confirmed</span>
    <% } else { %>
      <button
        hx-put="/observations/<%= observation.id %>/confirm"
        hx-target="closest li"
        hx-swap="outerHTML"
        class="rounded bg-emerald-600 px-2 py-1 text-xs font-semibold text-white hover:bg-emerald-700"
      >Confirm</button>
    <% } %>
  </span>
</li>
